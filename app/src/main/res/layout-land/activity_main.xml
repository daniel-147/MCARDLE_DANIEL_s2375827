<?xml version="1.0" encoding="utf-8"?><!-- MPD XML Starter code 2025-2026 -->
<ViewSwitcher xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vwSwitch"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <RelativeLayout xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/salutation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:text="Traffic Updates"
            android:textSize="20sp" />

        <RelativeLayout
            android:id="@+id/buttonGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:padding="5dp">

            <TextView
                android:id="@+id/colorKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerHorizontal="true"
                android:text="Background colour\nindicates delay length\nWhite \n - Unknown\nPale Yellow \n - Uncertain Duration\nYellow \n - Delays\nOrange \n - Long Delays\nRed \n - Very Long Delays"
                android:textAlignment="viewStart"
                android:textSize="15sp" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="130dp"
                android:layout_height="45dp"
                android:layout_below="@id/colorKey"
                android:layout_alignParentStart="true"
                android:backgroundTint="@color/buttons"
                android:padding="10dp"
                android:text="Clear Filters"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/sortButton"
                android:layout_width="130dp"
                android:layout_height="45dp"
                android:layout_below="@+id/clearButton"
                android:layout_alignParentStart="true"
                android:backgroundTint="@color/buttons"
                android:padding="10dp"
                android:text="Sort By Distance"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/mapButton"
                android:layout_width="130dp"
                android:layout_height="45dp"
                android:layout_below="@+id/sortButton"
                android:layout_alignParentStart="true"
                android:backgroundTint="@color/buttons"
                android:padding="10dp"
                android:text="Map View"
                android:textColor="@color/black" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/salutation"
            android:layout_toEndOf="@+id/buttonGroup">

            <TextView
                android:id="@+id/searchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/searchBar"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:text="Search by Road Name"
                android:textSize="14dp" />

            <EditText
                android:id="@+id/searchBar"
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/searchLabel"
                android:inputType="text"
                android:text="" />

            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_toEndOf="@+id/searchBar"
                android:backgroundTint="@color/white"
                android:contentDescription="Search button"
                android:src="@drawable/search" />


            <TextView
                android:id="@+id/acknowledgement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/searchButton"
                android:layout_alignParentStart="true"
                android:layout_centerHorizontal="true"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:text="Contains Traffic Scotland data"
                android:textSize="20sp" />

            <ViewSwitcher
                android:id="@+id/vwSwitchBar"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_below="@id/acknowledgement">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ProgressBar
                        android:id="@+id/bar1"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ListView
                        android:id="@+id/list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/acknowledgement"
                        android:layout_centerHorizontal="true"
                        android:divider="@color/buttons"
                        android:dividerHeight="3dp"
                        android:padding="10dp"></ListView>
                </LinearLayout>
            </ViewSwitcher>
        </RelativeLayout>
    </RelativeLayout>

    <RelativeLayout xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/mapScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".MainActivity">

        <Button
            android:id="@+id/listButton"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:backgroundTint="@color/buttons"
            android:text="Back to List View"
            android:textColor="@color/black" />

        <fragment xmlns:map="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/listButton"
            tools:context="myandroidstuff.me.org.mapflipperexample.MapsFlipperActivity" />
    </RelativeLayout>

</ViewSwitcher>